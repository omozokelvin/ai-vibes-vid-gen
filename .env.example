# Application
PORT=3000
NODE_ENV=development

# Google Gemini API (used for script generation only)
GEMINI_API_KEY=your_gemini_api_key_here

# Local image generation via ComfyUI (free, runs on your machine)
# Set LOCAL_IMAGE_API_URL to enable the local provider. It should be the ComfyUI
# base URL (no trailing slash). SDXL workflow is used by default.
# Install: https://github.com/comfyanonymous/ComfyUI
# Model: download sd_xl_base_1.0.safetensors into ComfyUI/models/checkpoints
# LOCAL_IMAGE_API_URL=http://127.0.0.1:8188
# LOCAL_IMAGE_MODEL=sd_xl_base_1.0.safetensors

# YouTube API (Google)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# TikTok API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Redis for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# File Storage
TEMP_DIR=./temp
DEBUG_DIR=./debug
