# Application
PORT=3000
NODE_ENV=development

# Google Gemini API (used for script generation only)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash  # Model used for script generation

# Local image generation via ComfyUI (free, runs on your machine)
# Set LOCAL_IMAGE_API_URL to enable the local provider. It should be the ComfyUI
# base URL (no trailing slash). Z-Image turbo workflow is used by default.
# Install: https://github.com/comfyanonymous/ComfyUI
# Model: install the "image_z_image_turbo" template via ComfyUI's Model Manager.
# Z-Image turbo uses three separate model files:
# LOCAL_IMAGE_API_URL=http://127.0.0.1:8188
# LOCAL_IMAGE_MODEL=z_image_turbo_bf16.safetensors
# LOCAL_IMAGE_CLIP=qwen_3_4b.safetensors
# LOCAL_IMAGE_VAE=ae.safetensors

# YouTube API (Google)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# TikTok API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Redis for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# File Storage
TEMP_DIR=./temp        # Intermediate processing files (cleaned up)
DEBUG_DIR=./debug      # Preserved debug artifacts for troubleshooting
VIDEOS_DIR=./videos    # Final assembled videos
